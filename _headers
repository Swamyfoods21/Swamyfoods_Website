#  Security headers for Netlify (Cloudflare Pages reads this file too).
# =====================================================================
#
#  Keep this file named exactly "_headers" and put it in the SAME folder as index.html
#  (the folder Netlify publishes).
#
#  ONE THING TO CHANGE BEFORE YOU UPLOAD:
#  replace YOUR-PROJECT-ID (it appears once, in the Content-Security-Policy line) with your
#  Supabase project id: the part before ".supabase.co" in your Project URL.
#  If you forget, the shop cannot reach its database and will say ordering is paused.
# =====================================================================

/*
 X-Content-Type-Options: nosniff
 X-Frame-Options: DENY
 Referrer-Policy: strict-origin-when-cross-origin
 Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
 Strict-Transport-Security: max-age=31536000
 Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://lcscwyqlihtpgnbjijrz.supabase.co; frame-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The admin page must never be stored or listed.
/admin.html
 Cache-Control: no-store
 X-Robots-Tag: noindex, nofollow

# Pages that show a customer's own details must never be kept by shared caches.
/account.html
 Cache-Control: no-store
/review.html
 Cache-Control: no-store
/thank-you.html
 Cache-Control: no-store

# Your connection settings: always fetch the latest copy.
/config.js
 Cache-Control: no-cache
